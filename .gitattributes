# ===== 文本文件：统一 LF 换行（跨 Windows/Linux/macOS 协作）=====
*.md    text eol=lf
*.tcl   text eol=lf
*.v     text eol=lf
*.sv    text eol=lf
*.xdc   text eol=lf
*.py    text eol=lf
*.f     text eol=lf
*.sh    text eol=lf
*.c     text eol=lf
*.h     text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.json  text eol=lf
*.ps1   text eol=crlf

# ===== 二进制文件：不做换行转换 =====
*.bit   binary
*.bin   binary
*.elf   binary
*.dcp   binary
*.zip   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.wdb   binary
